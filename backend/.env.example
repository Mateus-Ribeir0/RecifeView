# Copie para .env (que não vai para o git) e ajuste.

# PostgreSQL local. Usuário e senha abaixo valem só para desenvolvimento.
API_URL_DO_BANCO=postgresql+psycopg://recifeview:recifeview_local@localhost:5432/recifeview

# Segredo que assina os tokens de acesso. Gere um novo com:
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SEGREDO_JWT=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Duração do token de acesso (minutos) e da sessão (horas).
API_MINUTOS_DO_TOKEN_DE_ACESSO=15
API_HORAS_DA_SESSAO=12

# Em produção o cookie de sessão só trafega por HTTPS. Localmente, sem HTTPS, use false.
API_COOKIE_SEGURO=false

# Origens que podem chamar a API direto (fora do proxy do Vite). Lista em JSON.
API_ORIGENS_PERMITIDAS=[]

# Pasta local da camada bruta: os arquivos enviados ficam aqui até a carga. Fica fora do git.
API_PASTA_DAS_IMPORTACOES=../data/importacoes

# Tamanho máximo de um arquivo enviado pelo painel, em megabytes.
API_TAMANHO_MAXIMO_DA_IMPORTACAO_MB=800

# Sal do id_local. Vem do grupo, nunca do repositório. Vazio: registros novos entram sem pseudônimo
# de endereço e ficam fora da reincidência.
API_SAL_DO_ID_LOCAL=

# Banco usado pelos testes de integração. Sem esta variável, eles são pulados.
API_URL_DO_BANCO_DE_TESTE=postgresql+psycopg://recifeview:recifeview_local@localhost:5432/recifeview_teste
