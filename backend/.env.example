# Copie para .env (que não vai para o git) e ajuste.

# PostgreSQL local. Usuário e senha abaixo valem só para desenvolvimento.
API_URL_DO_BANCO=postgresql+psycopg://recifeview:recifeview_local@localhost:5432/recifeview

# Segredo que assina os tokens de acesso. Gere um novo com:
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SEGREDO_JWT=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Duração do token de acesso (minutos) e da sessão (horas).
API_MINUTOS_DO_TOKEN_DE_ACESSO=15
API_HORAS_DA_SESSAO=12

# Em produção o cookie de sessão só trafega por HTTPS. Localmente, sem HTTPS, use false.
API_COOKIE_SEGURO=false

# Origens que podem chamar a API direto (fora do proxy do Vite). Lista em JSON.
API_ORIGENS_PERMITIDAS=[]

# Pasta local da camada bruta: os arquivos enviados ficam aqui até a carga. Fica fora do git.
API_PASTA_DAS_IMPORTACOES=../data/importacoes

# Tamanho máximo de um arquivo enviado pelo painel, em megabytes.
API_TAMANHO_MAXIMO_DA_IMPORTACAO_MB=800

# Sal do id_local. Vem do grupo, nunca do repositório. Vazio: registros novos entram sem pseudônimo
# de endereço e ficam fora da reincidência.
API_SAL_DO_ID_LOCAL=

# Pasta onde os e-mails de conta (código de nova senha) são gravados quando
# não há servidor SMTP configurado. Fica fora do git.
API_PASTA_DOS_EMAILS=../data/emails

# Envio de verdade por SMTP. Com API_SMTP_SERVIDOR vazio, os e-mails ficam na pasta acima.
# O provedor definitivo ainda está em aberto (ADR 0010). A senha nunca entra no repositório.
# Exemplo com Gmail: servidor smtp.gmail.com, porta 587, usuário = o endereço Gmail e senha =
# uma senha de app de 16 letras, sem espaços (exige verificação em duas etapas).
API_SMTP_SERVIDOR=
API_SMTP_PORTA=587
# starttls (porta 587) ou ssl (porta 465)
API_SMTP_SEGURANCA=starttls
API_SMTP_USUARIO=
API_SMTP_SENHA=
# Endereço que aparece como remetente. Vazio: usa o API_SMTP_USUARIO.
API_SMTP_REMETENTE=

# Encaminhamento ao órgão (ADR 0011). Endereço público do site, usado no link de retorno que vai
# na mensagem ao órgão.
API_ENDERECO_DO_SITE=http://localhost:5173
# Pasta onde ficam as mensagens dos órgãos sem canal configurado. Fica fora do git.
API_PASTA_DOS_ENCAMINHAMENTOS=../data/encaminhamentos
# Canal de cada órgão, em JSON. Órgão fora da lista recebe pela pasta acima. Canais: email
# (usa o SMTP acima) e webhook (POST do JSON no endereço, com token opcional). Exemplo fictício:
# API_CANAIS_DOS_ORGAOS={"COMPESA": {"canal": "email", "destino": "ocorrencias@exemplo.com"}, "NEOENERGIA": {"canal": "webhook", "destino": "https://exemplo.com/ocorrencias", "token": "troque"}}
API_CANAIS_DOS_ORGAOS={}

# Outras origens da importação (ADR 0012). Hosts de onde dá para baixar, em JSON.
API_HOSTS_DE_IMPORTACAO=["dados.recife.pe.gov.br"]
# Conexões de leitura para importar de um banco, em JSON (nome e URL). Só PostgreSQL por
# enquanto. A URL tem senha: nunca no repositório. Exemplo fictício:
# API_BANCOS_DE_ORIGEM={"sgde": "postgresql+psycopg://leitura:troque@banco.exemplo:5432/sgde"}
API_BANCOS_DE_ORIGEM={}
# Tempo máximo de uma consulta ao banco externo, em segundos.
API_SEGUNDOS_DA_EXTRACAO=120

# Banco usado pelos testes de integração. Sem esta variável, eles são pulados.
API_URL_DO_BANCO_DE_TESTE=postgresql+psycopg://recifeview:recifeview_local@localhost:5432/recifeview_teste
